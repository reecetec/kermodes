from os import PathLike
from typing import Literal, overload

class KermodesError(Exception): ...

def merge(*tables: Table) -> Table: ...

class Session:
    def __init__(
        self,
        path: str | PathLike[str] | None = None,
        url: str | None = None,
        catalog: str | None = None,
        branch: str = "prod",
    ) -> None: ...
    def input_table(
        self, columns: dict[str, str], key: str | list[str] | None = None
    ) -> Table: ...
    def static_table(self, data: object) -> Table: ...
    def step(self) -> int: ...
    def start(self, min_period: str | None = None) -> None: ...
    def stop(self) -> None: ...
    @property
    def is_running(self) -> bool: ...
    @property
    def table_count(self) -> int: ...
    def serve(
        self,
        port: int = 0,
        host: str = "127.0.0.1",
        control: str | None = None,
        at: str | None = None,
        app: str | PathLike[str] | None = None,
    ) -> Server: ...
    def create_table(
        self,
        name: str,
        columns: dict[str, str],
        key: str | list[str] | None = None,
        sort: str | list[str] | None = None,
    ) -> None: ...
    @property
    def tables(self) -> list[str]: ...
    def writer(
        self, name: str, source: str = "default", wait: bool = False
    ) -> Writer: ...
    def table(self, name: str) -> Table: ...
    def live_table(self, name: str) -> Table: ...
    def sql(self, query: str, **tables: Table) -> Table: ...
    def live_sql(self, query: str, **tables: Table) -> Table: ...
    def merge_history(self, name: str, date: str) -> dict[str, int]: ...
    def write_history(self, name: str, date: str, data: object) -> dict[str, int]: ...
    def replay(self, first: str, last: str, step: str = "100ms") -> Replay: ...
    def changes(self, name: str) -> Table: ...
    def publish(self, name: str, table: Table, key: str | list[str]) -> Publication: ...
    def serve_store(self, port: int = 0, host: str = "127.0.0.1") -> StoreServer: ...
    def ingest_websocket(
        self,
        url: str,
        table: str,
        source: str = "websocket",
        flush: str = "100ms",
        max_rows: int = 10_000,
        wait: bool = False,
        seq: str | None = None,
    ) -> Ingest: ...

class Replay:
    def live_table(self, name: str, ts: str = "ts") -> Table: ...
    def create_table(
        self,
        name: str,
        columns: dict[str, str],
        key: str | list[str] | None = None,
        sort: str | list[str] | None = None,
    ) -> None: ...
    def publish(self, name: str, table: Table, key: str | list[str]) -> None: ...
    def step(self) -> int | None: ...
    def run(self, speed: float | None = None) -> None: ...
    @property
    def time(self) -> int | None: ...
    @property
    def cycles(self) -> int: ...
    @property
    def rows(self) -> int: ...
    @property
    def dates(self) -> tuple[str, str]: ...

class Ingest:
    @property
    def stats(self) -> IngestStats: ...
    def stop(self) -> None: ...

class IngestStats:
    messages: int
    rows: int
    skipped: int
    duplicates: int
    missed: int
    batches: int
    reconnects: int
    reopens: int
    connected: bool
    writing: bool
    failed: bool
    last_error: str | None

class Ticker:
    @property
    def url(self) -> str: ...
    def stop(self) -> None: ...

def control(config: str) -> None: ...
def serve_replica(
    data_dir: PathLike[str] | str,
    catalog: str,
    branch: str,
    replica: int,
    peers: list[str],
    host: str,
    port: int,
) -> None: ...
def ticker(
    port: int = 0, rate: int = 1_000, symbols: int = 100, host: str = "127.0.0.1"
) -> Ticker: ...

class StoreServer:
    @property
    def url(self) -> str: ...
    def stop(self) -> None: ...

class Pending:
    def wait(self) -> bool: ...

class Writer:
    @overload
    def write(
        self, data: object, seq: int | None = None, *, wait: Literal[True] = True
    ) -> bool: ...
    @overload
    def write(
        self, data: object, seq: int | None = None, *, wait: Literal[False]
    ) -> Pending: ...
    @overload
    def upsert(
        self, data: object, seq: int | None = None, *, wait: Literal[True] = True
    ) -> bool: ...
    @overload
    def upsert(
        self, data: object, seq: int | None = None, *, wait: Literal[False]
    ) -> Pending: ...
    @overload
    def delete(
        self, data: object, seq: int | None = None, *, wait: Literal[True] = True
    ) -> bool: ...
    @overload
    def delete(
        self, data: object, seq: int | None = None, *, wait: Literal[False]
    ) -> Pending: ...
    def flush(self) -> None: ...
    @property
    def last_seq(self) -> int | None: ...
    @property
    def epoch(self) -> int | None: ...

class Publication:
    @property
    def error(self) -> str | None: ...
    def stop(self) -> None: ...

class Table:
    @property
    def columns(self) -> list[tuple[str, str]]: ...
    @property
    def is_refreshing(self) -> bool: ...
    def append(self, data: object) -> None: ...
    def upsert(self, data: object) -> None: ...
    def delete(self, data: object) -> None: ...
    def where(self, predicate: str) -> Table: ...
    def update(self, *assignments: str) -> Table: ...
    def select(self, *columns: str) -> Table: ...
    def last_by(self, *columns: str) -> Table: ...
    def head(self, n: int) -> Table: ...
    def tail(self, n: int) -> Table: ...
    def slice(self, start: int, stop: int) -> Table: ...
    def sort(self, *by: str) -> Table: ...
    def agg_by(self, *columns: str, **aggregations: str) -> Table: ...
    def rolling(
        self,
        *by: str,
        rows: int | None = None,
        time: str | int | None = None,
        at: str | None = None,
        **aggregations: str,
    ) -> Table: ...
    def natural_join(
        self, right: Table, on: str | list[str], joins: list[str] | None = None
    ) -> Table: ...
    def as_of_join(
        self,
        right: Table,
        on: str | list[str],
        at: str,
        joins: list[str] | None = None,
    ) -> Table: ...
    def explain(self) -> str: ...
    def __len__(self) -> int: ...
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...
    @property
    def _changed(self) -> int: ...
    def _ipython_display_(self) -> None: ...

class Viewer:
    def __init__(self, table: Table) -> None: ...
    def receive(self, message: dict) -> tuple[dict, bytes, bytes] | None: ...
    def rows(self) -> tuple[dict, bytes, bytes] | None: ...
    @property
    def changed(self) -> int | None: ...
    def release(self) -> None: ...
    @property
    def sort(self) -> list[tuple[str, bool]]: ...
    @property
    def filters(self) -> dict[str, str]: ...
    @property
    def filter_errors(self) -> dict[str, str]: ...
    @property
    def applied(self) -> int: ...
    def status(self) -> str: ...

class Server:
    @property
    def url(self) -> str: ...
    def publish(self, name: str, table: Table) -> None: ...
    def publish_view(self, name: str, table: Table) -> None: ...
    def unpublish(self, name: str) -> bool: ...
    def serve_app(self, project: str, name: str, dev: str, process: str) -> None: ...
    def stop_app(self, project: str, name: str) -> bool: ...
    @property
    def published(self) -> list[str]: ...
    def stop(self) -> None: ...
