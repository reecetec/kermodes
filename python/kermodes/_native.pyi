from os import PathLike

class KermodesError(Exception): ...

def merge(*tables: Table) -> Table: ...

class Session:
    def __init__(
        self,
        path: str | PathLike[str] | None = None,
        url: str | None = None,
        catalog: str | None = None,
        branch: str = "prod",
    ) -> None: ...
    def input_table(
        self, columns: dict[str, str], key: str | list[str] | None = None
    ) -> Table: ...
    def static_table(self, data: object) -> Table: ...
    def step(self) -> int: ...
    def start(self, min_period: str | None = None) -> None: ...
    def stop(self) -> None: ...
    @property
    def is_running(self) -> bool: ...
    @property
    def table_count(self) -> int: ...
    def serve(
        self, port: int = 0, host: str = "127.0.0.1", control: str | None = None
    ) -> Server: ...
    def create_table(self, name: str, columns: dict[str, str]) -> None: ...
    @property
    def tables(self) -> list[str]: ...
    def writer(
        self, name: str, source: str = "default", wait: bool = False
    ) -> Writer: ...
    def live_table(self, name: str) -> Table: ...
    def serve_store(self, port: int = 0, host: str = "127.0.0.1") -> StoreServer: ...
    def ingest_websocket(
        self,
        url: str,
        table: str,
        source: str = "websocket",
        flush: str = "100ms",
        max_rows: int = 10_000,
        wait: bool = False,
        seq: str | None = None,
    ) -> Ingest: ...

class Ingest:
    @property
    def stats(self) -> IngestStats: ...
    def stop(self) -> None: ...

class IngestStats:
    messages: int
    rows: int
    skipped: int
    duplicates: int
    missed: int
    batches: int
    reconnects: int
    connected: bool
    writing: bool
    failed: bool
    last_error: str | None

class Ticker:
    @property
    def url(self) -> str: ...
    def stop(self) -> None: ...

def control(config: str) -> None: ...
def ticker(
    port: int = 0, rate: int = 1_000, symbols: int = 100, host: str = "127.0.0.1"
) -> Ticker: ...

class StoreServer:
    @property
    def url(self) -> str: ...
    def stop(self) -> None: ...

class Writer:
    def write(self, data: object, seq: int | None = None) -> bool: ...
    @property
    def last_seq(self) -> int | None: ...
    @property
    def epoch(self) -> int | None: ...

class Table:
    @property
    def columns(self) -> list[tuple[str, str]]: ...
    @property
    def is_refreshing(self) -> bool: ...
    def append(self, data: object) -> None: ...
    def upsert(self, data: object) -> None: ...
    def delete(self, data: object) -> None: ...
    def where(self, predicate: str) -> Table: ...
    def update(self, *assignments: str) -> Table: ...
    def select(self, *columns: str) -> Table: ...
    def last_by(self, *columns: str) -> Table: ...
    def head(self, n: int) -> Table: ...
    def tail(self, n: int) -> Table: ...
    def sort(self, *by: str) -> Table: ...
    def agg_by(self, *columns: str, **aggregations: str) -> Table: ...
    def rolling(
        self,
        *by: str,
        rows: int | None = None,
        time: str | int | None = None,
        at: str | None = None,
        **aggregations: str,
    ) -> Table: ...
    def natural_join(
        self, right: Table, on: str | list[str], joins: list[str] | None = None
    ) -> Table: ...
    def as_of_join(
        self,
        right: Table,
        on: str | list[str],
        at: str,
        joins: list[str] | None = None,
    ) -> Table: ...
    def __len__(self) -> int: ...
    def __arrow_c_stream__(self, requested_schema: object | None = None) -> object: ...
    @property
    def _changed(self) -> int: ...
    def _preview_html(self, rows: int) -> str: ...
    def _ipython_display_(self) -> None: ...

class Viewer:
    def __init__(self, table: Table) -> None: ...
    def receive(self, message: dict) -> tuple[dict, bytes, bytes] | None: ...
    def rows(self) -> tuple[dict, bytes, bytes] | None: ...
    @property
    def changed(self) -> int | None: ...
    def release(self) -> None: ...
    @property
    def sort(self) -> list[tuple[str, bool]]: ...
    @property
    def filters(self) -> dict[str, str]: ...
    @property
    def filter_errors(self) -> dict[str, str]: ...
    def status(self, cycle: int) -> str: ...

class Server:
    @property
    def url(self) -> str: ...
    def publish(self, name: str, table: Table) -> None: ...
    def unpublish(self, name: str) -> bool: ...
    @property
    def published(self) -> list[str]: ...
    def stop(self) -> None: ...
